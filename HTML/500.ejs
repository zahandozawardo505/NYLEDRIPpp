<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NYLEDRIP | Server Error</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/CSS/style-base.css">
    <style>
        .error-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 80vh;
            text-align: center;
            padding: 20px;
        }
        .error-code {
            font-size: 8rem;
            font-weight: 900;
            color: #dc3545;
            margin: 0;
            line-height: 1;
            text-shadow: 0 4px 20px rgba(220,53,69,0.2);
        }
        .error-title {
            font-size: 2.5rem;
            margin-bottom: 20px;
            text-transform: uppercase;
            font-weight: 800;
        }
        .error-msg {
            color: var(--text-secondary);
            font-size: 1.2rem;
            max-width: 500px;
            margin-bottom: 40px;
        }
    </style>
</head>
<body>
    <%- include('index.ejs') %>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mainContainer = document.querySelector('main') || document.body;
            mainContainer.innerHTML = `
                <div class="error-container">
                    <h1 class="error-code">500</h1>
                    <h2 class="error-title">Server Error</h2>
                    <p class="error-msg">Oops, something went wrong on our end. Our engineers have been notified. Please try again later.</p>
                    <a href="/" class="btn btn-primary" style="padding: 15px 40px; font-size: 1.1rem;">Return Home</a>
                </div>
            `;
        });
    </script>
</body>
</html>
