<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product - NYLEDRIP</title>
    <link rel="icon" href="../assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/CSS/style-base.css?v=5">
    <link rel="stylesheet" href="/CSS/style-product.css?v=6">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="navbar-menu" id="navbarMenu">
                <a href="/shop" class="nav-link">Shop</a>
                <a href="/shop?view=reels" class="nav-link">Reels</a>
                <a href="/seller-signup" class="nav-link">Sell</a>
            </div>
            <div class="navbar-brand">
                <a href="/" class="logo navbar-text-logo">NYLEDRIP</a>
            </div>
            <div class="navbar-actions">
                <div class="navbar-search-wrapper">
                    <input id="globalSearch" placeholder="SEARCH...">
                    <div id="searchSuggestions" class="search-suggestions" style="display:none;"></div>
                </div>
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                </button>
                <a href="/wishlist" class="cart-icon-btn" aria-label="Wishlist">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    <span class="cart-nav-badge" id="wishlistNavBadge" style="display:none">0</span>
                </a>
                <a href="/cart" class="cart-icon-btn" aria-label="Cart">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    <span class="cart-nav-badge" id="cartNavBadge" style="display:none">0</span>
                </a>
                <div id="navbarAuth">
                    <a href="/login" class="nav-link-auth">Login</a>
                </div>
            </div>
        </div>
    </nav>

    <section class="product-section">
        <div class="container">
            <a href="/shop" class="back-link">&larr; Back to Shop</a>
            <div class="product-layout">
                <div class="product-images">
                    <div class="main-image">
                        <img id="mainImage" src="" alt="Product Image">
                    </div>
                    <div class="thumbnail-images" id="thumbnailContainer"></div>
                </div>
                <div class="product-details">
                    <div class="breadcrumb" id="breadcrumb"></div>
                    <h1 id="productName"></h1>
                    <div class="product-price"><span id="productPrice"></span> <span class="currency">EGP</span></div>
                    
                    <p class="product-description" id="productDescription"></p>

                    <div class="form-group">
                        <label>Color</label>
                        <div class="color-options" id="colorContainer"></div>
                    </div>

                    <div class="form-group">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <label style="margin:0;">Size</label>
                            <a href="#" id="openSizeGuideBtn" style="font-size:0.9rem; text-decoration:underline; color:var(--text-secondary);">Size Guide</a>
                        </div>
                        <div class="size-options" id="sizeContainer"></div>
                    </div>

                    <div class="form-group">
                        <label>Quantity</label>
                        <div class="quantity-selector">
                            <button class="qty-btn" id="decreaseQty">-</button>
                            <input type="number" id="quantity" value="1" min="1" max="10" readonly>
                            <button class="qty-btn" id="increaseQty">+</button>
                        </div>
                    </div>

                    <div class="product-actions">
                        <button class="btn btn-primary btn-large btn-block" id="addToCartBtn">Add to Cart</button>
                        <button class="btn btn-secondary" id="wishlistBtn">Wishlist</button>
                    </div>

                    <div class="stock-status" id="stockStatus"></div>

                    <div class="product-info">
                        <div class="info-item"><span>&#10003;</span> 100% Authentic Guarantee</div>
                        <div class="info-item"><span>&#8634;</span> 14-Day Returns</div>
                        <div class="info-item"><span>&#9992;</span> Fast Local Shipping</div>
                    </div>

                    <div class="seller-card" id="sellerCard">
                        <h3>About the Brand</h3>
                        <p id="sellerName" style="font-weight:700;margin-bottom:8px;"></p>
                        <p id="sellerDesc" style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:16px;"></p>
                        <a href="#" id="sellerLink" class="btn btn-secondary">View Brand Profile</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="product-reviews" style="background: var(--bg-secondary); padding: var(--spacing-2xl) 0;">
        <div class="container">
            <h2 style="font-size: 2rem; font-weight: 900; text-transform: uppercase; margin-bottom: var(--spacing-lg);">Customer Reviews</h2>
            <div class="reviews-layout" style="display: grid; grid-template-columns: 1fr 2fr; gap: var(--spacing-xl);">
                <div class="reviews-summary" id="reviewsSummary">
                    <div style="font-size: 2rem; font-weight: 900; line-height: 1;">No reviews yet</div>
                    <button class="btn btn-primary" style="margin-top: 20px;" id="writeReviewBtn">Write a Review</button>
                </div>
                <div class="reviews-list" id="reviewsList">
                    <!-- Dynamic reviews will load here -->
                </div>
            </div>
        </div>
    </section>

    <!-- Write Review Modal -->
    <div id="reviewModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; z-index:9999;">
        <div class="modal-content" style="max-width: 500px; width: 90%; background: var(--bg-primary); padding:40px; border-radius:12px; position:relative;">
            <button class="modal-close" id="closeReviewModalBtn" style="position:absolute; top:15px; right:15px; z-index:10;">&times;</button>
            <h2 style="margin-bottom: 20px; font-weight:900; text-transform:uppercase;">Write a Review</h2>
            <div id="reviewEligibilityMessage" style="margin-bottom: 15px; font-weight: 700; color: var(--text-secondary);"></div>
            <form id="reviewForm" style="display:none;">
                <div style="margin-bottom: 15px;">
                    <label>Rating (1-5)</label>
                    <select id="reviewRating" style="width: 100%; padding: 10px; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-primary);">
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Good</option>
                        <option value="3">3 - Average</option>
                        <option value="2">2 - Poor</option>
                        <option value="1">1 - Terrible</option>
                    </select>
                </div>
                <div style="margin-bottom: 15px;">
                    <label>Comment</label>
                    <textarea id="reviewComment" style="width: 100%; padding: 10px; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-primary); height: 100px;" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Submit Review</button>
            </form>
        </div>
    </div>

    <section class="related-products">
        <div class="container">
            <h2>You May Also Like</h2>
            <div class="products-grid" id="relatedGrid"></div>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <a href="/" class="footer-logo">NYLEDRIP</a>
                    <p>Supporting local Egyptian fashion brands with direct-to-brand shopping, curated drops, and no middleman.</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="shop">Shop</a></li>
                        <li><a href="seller-signup">Become a Seller</a></li>
                        <li><a href="login">Login</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Contact</h4>
                    <ul class="footer-contact-list">
                        <li><a href="mailto:hello@niledrip.com">hello@niledrip.com</a></li>
                        <li>Cairo, Egypt</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 NYLEDRIP. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/JS/store.js?v=4"></script>
<script src="/JS/db.js?v=4"></script>
<script src="/JS/api.js?v=4"></script>
<script src="/JS/utils.js?v=4"></script>
<script src="/JS/theme.js?v=4"></script>
<script src="/JS/main.js?v=4"></script>

<script src="/JS/product-page.js?v=4"></script>


<!-- Size Guide Modal -->
<div id="sizeGuideModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; z-index:9999;">
    <div class="modal-content" style="max-width: 600px; width: 90%; background: var(--bg-primary); padding:40px; border-radius:12px; position:relative;">
        <button class="modal-close" id="closeSizeGuideBtn" style="position:absolute; top:15px; right:15px; z-index:10;">&times;</button>
        <h2 style="margin-bottom: 20px; font-weight:900; text-transform:uppercase;">Size Guide (cm)</h2>
        <table style="width:100%; text-align:left; border-collapse:collapse;">
            <thead>
                <tr style="border-bottom:1px solid var(--border-color);">
                    <th style="padding:10px 0;">Size</th>
                    <th style="padding:10px 0;">Chest</th>
                    <th style="padding:10px 0;">Length</th>
                    <th style="padding:10px 0;">Sleeve</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom:1px solid var(--border-color);"><td style="padding:10px 0;">S</td><td style="padding:10px 0;">50</td><td style="padding:10px 0;">70</td><td style="padding:10px 0;">20</td></tr>
                <tr style="border-bottom:1px solid var(--border-color);"><td style="padding:10px 0;">M</td><td style="padding:10px 0;">54</td><td style="padding:10px 0;">72</td><td style="padding:10px 0;">21</td></tr>
                <tr style="border-bottom:1px solid var(--border-color);"><td style="padding:10px 0;">L</td><td style="padding:10px 0;">58</td><td style="padding:10px 0;">74</td><td style="padding:10px 0;">22</td></tr>
                <tr style="border-bottom:1px solid var(--border-color);"><td style="padding:10px 0;">XL</td><td style="padding:10px 0;">62</td><td style="padding:10px 0;">76</td><td style="padding:10px 0;">23</td></tr>
            </tbody>
        </table>
        <p style="margin-top:20px; color:var(--text-secondary); font-size:0.9rem;">Measurements are approximate and may vary slightly. Fits oversized.</p>
    </div>
</div>
<script>
    const sgModal = document.getElementById("sizeGuideModal");
    const openSg = document.getElementById("openSizeGuideBtn");
    const closeSg = document.getElementById("closeSizeGuideBtn");
    if(openSg) openSg.addEventListener("click", (e) => { e.preventDefault(); sgModal.style.display="flex"; });
    if(closeSg) closeSg.addEventListener("click", () => sgModal.style.display="none");
    if(sgModal) sgModal.addEventListener("click", (e) => { if(e.target===sgModal) sgModal.style.display="none"; });
</script>
</body>
</html>

