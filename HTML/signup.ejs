<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - NYLEDRIP</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/CSS/style-base.css?v=5">
    <link rel="stylesheet" href="/CSS/style-login-signup.css?v=4">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a href="/" class="logo navbar-text-logo">NYLEDRIP</a>
            </div>
            <div class="navbar-actions">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                </button>
            </div>
        </div>
    </nav>

    <section class="auth-section">
        <div class="auth-container">
            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Join the exclusive streetwear community</p>
            
            <form id="signupForm" class="auth-form">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="signupName" required>
                    <div class="error-msg" id="signupNameError"></div>
                </div>
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" id="signupEmail" required>
                    <div class="error-msg" id="signupEmailError"></div>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" id="signupPassword" autocomplete="new-password" required>
                    <div class="password-strength" id="passwordStrength" aria-live="polite">
                        <div class="password-strength-track">
                            <span class="password-strength-bar" id="passwordStrengthBar"></span>
                        </div>
                        <div class="password-strength-meta">
                            <span id="passwordStrengthLabel">Password strength</span>
                            <span id="passwordStrengthHint">Use 8+ characters with letters, numbers, and a symbol.</span>
                        </div>
                    </div>
                    <div class="error-msg" id="signupPasswordError"></div>
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" id="signupConfirmPassword" autocomplete="new-password" required>
                    <div class="error-msg" id="signupConfirmPasswordError"></div>
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;padding:14px;font-size:1rem;" id="signupBtn">Create Account</button>
            </form>

            <div class="form-divider"><span>OR</span></div>

            <div class="social-buttons">
                <button type="button" class="btn-social btn-google" id="googleSignupBtn">
                    <svg width="20" height="20" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/><path d="M1 1h22v22H1z" fill="none"/></svg>
                    Sign up with Google
                </button>
            </div>

            <div class="auth-footer">
                Already have an account? <a href="/login" class="auth-link">Sign In</a>
            </div>
        </div>
    </section>

    <script src="/JS/store.js?v=4"></script>
<script src="/JS/db.js?v=4"></script>
<script src="/JS/api.js?v=4"></script>
<script src="/JS/utils.js?v=4"></script>
<script src="/JS/theme.js?v=4"></script>
<script src="/JS/main.js?v=4"></script>

<script src="/JS/signup.js?v=5"></script>

</body>
</html>


