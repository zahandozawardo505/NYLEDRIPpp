<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - NYLEDRIP</title>
    <link rel="icon" href="../assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/CSS/style-base.css?v=5">
    <link rel="stylesheet" href="/CSS/style-shop.css?v=9">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="navbar-menu" id="navbarMenu">
                <a href="/shop" class="nav-link active">Shop</a>
                <a href="/shop?view=reels" class="nav-link">Reels</a>
                <a href="/seller-signup" class="nav-link">Sell</a>
            </div>
            <div class="navbar-brand">
                <a href="/" class="logo navbar-text-logo">NYLEDRIP</a>
            </div>
            <div class="navbar-actions">
                <div class="navbar-search-wrapper">
                    <input id="globalSearch" placeholder="SEARCH...">
                    <div id="searchSuggestions" class="search-suggestions" style="display:none;"></div>
                </div>
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                </button>
                <a href="/wishlist" class="cart-icon-btn" aria-label="Wishlist">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    <span class="cart-nav-badge" id="wishlistNavBadge" style="display:none">0</span>
                </a>
                <a href="/cart" class="cart-icon-btn" aria-label="Cart">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    <span class="cart-nav-badge" id="cartNavBadge" style="display:none">0</span>
                </a>
                <div id="navbarAuth">
                    <a href="/login" class="nav-link-auth">Login</a>
                </div>
            </div>
        </div>
    </nav>

    <header class="shop-header">
        <div class="container">
            <h1>COLLECTION</h1>
        </div>
    </header>

    <section class="shop-section">
        <div class="drawer-overlay" id="drawerOverlay"></div>
        <div class="container shop-layout" id="shopLayout">
            
            <aside class="shop-sidebar" id="filterDrawerPanel">
                <div class="filter-head">
                    <h2>FILTERS</h2>
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <button type="button" id="resetFilters">RESET</button>
                        <button type="button" id="closeFilters" class="close-filters-btn" aria-label="Close filters">&times;</button>
                    </div>
                </div>

                <div class="filter-group filter-stock-group">
                    <label class="stock-toggle">
                        <input type="checkbox" id="availableOnly">
                        <span class="stock-toggle-control" aria-hidden="true"></span>
                        <span class="stock-toggle-label">In Stock Only</span>
                    </label>
                </div>
                
                <div class="filter-group">
                    <h3 class="filter-title">Gender</h3>
                    <div class="filter-options">
                        <label class="filter-checkbox"><input type="checkbox" class="gender-filter" value="Men"> Men</label>
                        <label class="filter-checkbox"><input type="checkbox" class="gender-filter" value="Women"> Women</label>
                        <label class="filter-checkbox"><input type="checkbox" class="gender-filter" value="Unisex"> Unisex</label>
                    </div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Category</h3>
                    <div class="filter-options">
                        <label class="filter-checkbox"><input type="checkbox" class="category-filter" value="Hoodies & Sweatshirts"> Hoodies</label>
                        <label class="filter-checkbox"><input type="checkbox" class="category-filter" value="Tops"> Tops</label>
                        <label class="filter-checkbox"><input type="checkbox" class="category-filter" value="Bottoms"> Bottoms</label>
                        <label class="filter-checkbox"><input type="checkbox" class="category-filter" value="Jackets"> Jackets</label>
                        <label class="filter-checkbox"><input type="checkbox" class="category-filter" value="Shoes"> Shoes</label>
                        <label class="filter-checkbox"><input type="checkbox" class="category-filter" value="Accessories"> Accessories</label>
                    </div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Price Range</h3>
                    <div class="price-range-dual">
                        <input type="range" id="priceMinRange" min="0" max="10000" value="0" step="10">
                        <input type="range" id="priceMaxRange" min="0" max="10000" value="10000" step="10">
                        <div class="price-caption">
                            <span>EGP <span id="priceMinValue">0</span></span>
                            <span>EGP <span id="priceMaxValue">Max</span></span>
                        </div>
                    </div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Brand/Seller</h3>
                    <div class="filter-options" id="sellerFilters"></div>
                </div>

                <div class="filter-group">
                    <h3 class="filter-title">Size</h3>
                    <div class="filter-options" id="sizeFilters"></div>
                </div>
            </aside>

            <main class="shop-main">
                <div class="shop-controls">
                    <div class="shop-controls-left" style="display: flex; align-items: center; gap: 16px;">
                        <button type="button" id="filterDrawerToggle" class="filter-toggle-btn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;">
                                <line x1="4" y1="21" x2="4" y2="14"></line>
                                <line x1="4" y1="10" x2="4" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12" y2="3"></line>
                                <line x1="20" y1="21" x2="20" y2="16"></line>
                                <line x1="20" y1="12" x2="20" y2="3"></line>
                                <line x1="1" y1="14" x2="7" y2="14"></line>
                                <line x1="9" y1="8" x2="15" y2="8"></line>
                                <line x1="17" y1="16" x2="23" y2="16"></line>
                            </svg>
                            Hide Filters
                        </button>
                        <div class="product-count">
                            <span id="productCount">0</span> Items
                        </div>
                    </div>
                    
                    <div class="shop-controls-right">
                        <div class="shop-view-switch" id="shopViewSwitch">
                            <button type="button" class="shop-view-btn active" data-view="products">Products</button>
                            <button type="button" class="shop-view-btn" data-view="reels">Reels</button>
                        </div>
                        
                        <select id="sortBy" class="sort-select">
                            <option value="newest">Newest Arrivals</option>
                            <option value="price-low">Price: Low to High</option>
                            <option value="price-high">Price: High to Low</option>
                            <option value="rating-high">Highest Rated</option>
                        </select>
                    </div>
                </div>

                <div id="productsView" class="shop-view-panel active">
                    <div id="noProducts" class="no-products" style="display:none;">NO PRODUCTS FOUND</div>
                    <div class="products-grid" id="productsGrid"></div>
                    <div id="shopPagination" style="margin-top:40px;text-align:center;"></div>
                </div>

                <div id="reelsView" class="shop-view-panel">
                    <div class="seller-reels-head" style="margin-bottom:20px;text-align:center;">
                        <h2>BRAND REELS</h2>
                        <div class="reels-platform-switch" id="reelsPlatformSwitch" style="display:flex;justify-content:center;gap:10px;margin-top:10px;">
                            <button class="btn btn-secondary reels-platform-btn active" data-platform="all">All</button>
                            <button class="btn btn-secondary reels-platform-btn" data-platform="instagram">Instagram</button>
                            <button class="btn btn-secondary reels-platform-btn" data-platform="tiktok">TikTok</button>
                        </div>
                    </div>
                    <div id="shopReelsEmpty" class="reels-empty">NO REELS FOUND</div>
                    <div class="reels-feed" id="shopReelsFeed"></div>
                </div>
            </main>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <a href="/" class="footer-logo">NYLEDRIP</a>
                    <p>Supporting local Egyptian fashion brands with direct-to-brand shopping, curated drops, and no middleman.</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="shop">Shop</a></li>
                        <li><a href="seller-signup">Become a Seller</a></li>
                        <li><a href="login">Login</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Contact</h4>
                    <ul class="footer-contact-list">
                        <li><a href="mailto:hello@niledrip.com">hello@niledrip.com</a></li>
                        <li>Cairo, Egypt</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 NYLEDRIP. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Quick View Modal -->
    <div class="modal" id="quickViewModal">
        <div class="modal-content">
            <button class="modal-close" id="quickViewCloseBtn">&times;</button>
            <div id="quickViewContent"></div>
        </div>
    </div>

    <!-- Reels Modal -->
    <div class="modal" id="reelFullscreenModal">
        <div class="modal-content" style="background:#000;padding:0;">
            <button class="modal-close" id="reelFullscreenCloseBtn" style="color:#fff;">&times;</button>
            <div id="reelFullscreenFrameWrap" style="height:80vh;"></div>
        </div>
    </div>

    <script src="/JS/store.js?v=4"></script>
<script src="/JS/db.js?v=4"></script>
<script src="/JS/api.js?v=4"></script>
<script src="/JS/utils.js?v=4"></script>
<script src="/JS/theme.js?v=4"></script>
<script src="/JS/main.js?v=4"></script>

<script src="/JS/shop.js?v=5"></script>

</body>
</html>


